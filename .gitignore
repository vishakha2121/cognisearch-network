├── frontend/
│   ├── src/
│   │   ├── components/   # UI Components
│   │   ├── pages/        # React Pages
│   │   ├── api/          # Axios setup
│   │   ├── hooks/        # Custom hooks
│   │   └── App.jsx
│   ├── package.json
│   └── tailwind.config.js
├── database/
